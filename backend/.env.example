# Server & DB
PROJECT_NAME="Indian Visual Voicemail Backend"
ENVIRONMENT="development"
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5432/voicemail_db"

# Webhook HMAC Secret
WEBHOOK_HMAC_SECRET="change_me_to_a_secure_random_key_hex_32"

# Telephony
SYSTEM_FORWARDING_DID="+918040000000"

# Storage
STORAGE_TYPE="supabase"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_BUCKET_NAME="voicemail-recordings"

# S3 Fallback
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="voicemail-recordings"

# Firebase Admin
FIREBASE_CREDENTIALS_PATH="/etc/voicemail/firebase-service-account.json"

# Transcription
WHISPER_MODEL_SIZE="small"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"

